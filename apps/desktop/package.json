{
  "name": "@orrama/desktop",
  "version": "0.1.0",
  "description": "Orrama desktop shell (Tauri 2): a native window on the local Orrama server.",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "tauri": "tauri",
    "fetch-node": "node ../../scripts/fetch-node.mjs",
    "package-server": "node ../../scripts/package-server.mjs",
    "prepare-bundle": "node ../../scripts/fetch-node.mjs && node ../../scripts/package-server.mjs && node ../../scripts/desktop-notices.mjs",
    "notices": "node ../../scripts/desktop-notices.mjs",
    "release:mac": "node ../../scripts/release-build.mjs --target aarch64-apple-darwin"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.5.0"
  }
}
