{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orrama",
  "version": "0.1.0",
  "identifier": "com.orrama.desktop",
  "build": {
    "frontendDist": "fallback"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; img-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUwODNDMDExNjNFMjZEMzEKUldReGJlSmpFY0NEVU1qbmJQZkVMNytFSlNwZmNtY2c2MW56aUtwT0VFc3B5dTBUTEt0ZFovUEoK",
      "endpoints": ["https://github.com/JewelsArt/orrama/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["app", "dmg", "nsis"],
    "publisher": "Jules Timothy Sekelj",
    "copyright": "Copyright © 2026 Jules Timothy Sekelj. Licensed under the GNU AGPL v3 or later.",
    "license": "AGPL-3.0-or-later",
    "licenseFile": "../../../LICENSE",
    "category": "Productivity",
    "shortDescription": "Notes, projects, planning, people, mail and money over a folder of Markdown.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.5",
      "signingIdentity": "-",
      "hardenedRuntime": false
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false,
        "installerHooks": "windows/hooks.nsh"
      }
    }
  }
}
