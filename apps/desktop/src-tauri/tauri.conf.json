{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Basalt",
  "version": "0.1.0",
  "identifier": "dev.basalt.app",
  "build": {
    "beforeDevCommand": "pnpm --dir ../web dev",
    "beforeBuildCommand": "pnpm --dir ../web build",
    "devUrl": "http://localhost:4625",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Basalt",
        "url": "http://localhost:4623",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Visible"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https:; img-src 'self' data: blob: https: http:; connect-src 'self' http://localhost:4623 ws://localhost:4623; frame-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
