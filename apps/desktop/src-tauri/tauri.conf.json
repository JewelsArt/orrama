{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Basalt",
  "version": "0.1.0",
  "identifier": "dev.basalt.app",
  "build": {
    "beforeDevCommand": "pnpm --dir ../web dev",
    "beforeBuildCommand": "pnpm --dir ../web build",
    "devUrl": "http://localhost:4625",
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Basalt",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
