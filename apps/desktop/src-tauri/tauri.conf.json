{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orrama",
  "version": "0.1.0",
  "identifier": "dev.basalt.app",
  "build": {
    "frontendDist": "fallback"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Orrama",
        "url": "index.html",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Visible"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; img-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "copyright": "Copyright © 2026 Jules Timothy Sekelj. Licensed under the GNU AGPL v3 or later.",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
