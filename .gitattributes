# Every text file is LF in every checkout. Git for Windows defaults to
# core.autocrlf=true, which turned the Dockerfile and the tests' fixtures into
# CRLF and made tests that read files line by line fail there (audit OPS-003).
* text=auto eol=lf

# Binary, never converted.
*.png binary
*.ico binary
*.icns binary
*.woff2 binary
*.db binary
*.xlsx binary
*.docx binary
*.pptx binary
*.pdf binary
