{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "basalt-server",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "apps/server",
        "dev"
      ],
      "port": 4627
    },
    {
      "name": "basalt-web-colors",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "BASALT_API_PORT=4627",
        "pnpm",
        "--dir",
        "apps/web",
        "dev",
        "--",
        "--port",
        "4675",
        "--strictPort"
      ],
      "port": 4675
    }
  ]
}
